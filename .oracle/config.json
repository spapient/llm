{
  // Oracle 0.23.1+；Node.js >= 24。项目级配置只保留可共享的工作流约束。
  // 浏览器专用顶级别名：必须确认 GPT-6 与 Pro 档位，不可用时报错，不静默降档。
  engine: "browser",
  model: "gpt-6-pro",
  search: "off",

  // 默认不把代码审查变成联网研究；需要时显式使用 --browser-research search|deep。
  filesReport: true,
  heartbeatSeconds: 30,
  maxFileSizeBytes: 1048576,

  browser: {
    chatgptUrl: "https://chatgpt.com/",
    modelStrategy: "select",
    thinkingTime: "pro",
    researchMode: "off",

    // 复用人工登录的隔离档案，不复制主浏览器 Cookie；首次使用需完成登录。
    manualLogin: true,
    headless: false,
    keepBrowser: false,

    // 串行审查避免跨标签污染；会话与附件均有明确的有界等待。
    maxConcurrentTabs: 1,
    timeoutMs: 3600000,
    inputTimeoutMs: 60000,
    attachmentTimeoutMs: 90000,

    // 本地会话保存完成后仍保留线上会话，便于独立复核。
    archiveConversations: "never",
  },

  // 每次审查统一追加证据契约；调用者仍须提供具体任务、相关源码与复现材料。
  promptSuffix: "请执行独立、对抗性、证据优先的代码审查，不要附和既定结论。只依据所给源码和可复现证据，按严重度先列可证实缺陷；每项给出文件与行号、触发条件、影响、最小复现和最小修复。重点检查正确性、安全与隐私、空输入、零值、极值与溢出、非法输入、数值稳定性、并发与原子性、部分失败、恢复一致性、资源生命周期、公共契约和测试缺口。不得建议删除测试、放宽门禁、隐藏警告、豁免错误或把推测当事实；性能结论必须有同机、同负载、同迭代次数的 release 基线和最终值。不得索取或输出密钥、令牌或 Cookie。若没有发现缺陷，明确写“未发现可证实缺陷”，并列出残余风险、未覆盖平台和仍需执行的验证。最后分别列出已验证事实、推断和未知项，不得宣称未经完整验证的任务已完成。",
}
