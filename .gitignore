# 构建产物
target/
# 临时工作目录：本地快照、编译中间产物、基线与符号表，均不入库
.tmp/

# jscpd 重复检测报告：输出在 target/jscpd-report（随 target/ 忽略）；
# /report/ 作为遗留保险，源码树不允许出现 report 目录。
/report/

# 工具与编辑器的本地状态
/.claude/
/.idea/
/.vscode/
/.junie/

# 系统文件
.DS_Store

# fuzz 种子语料由 tests/gen_corpus.rs 从库编码生成，二进制不入库；字典与说明除外
/crates/fuzz/corpus/*/*.bin
# libtest 超时/失败写回的 slow-unit 样本是运行残留，不入库
/crates/fuzz/slow-unit-*
